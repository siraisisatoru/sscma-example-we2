@@ -84,6 +84,14 @@ MA_ATTR_WEAK void yuv422p_to_rgb(const ma_img_t* src, ma_img_t* dst) {
                 dst->data[index * 3 + 0] = (uint8_t)MA_CLIP(r, 0, 255);
                 dst->data[index * 3 + 1] = (uint8_t)MA_CLIP(g, 0, 255);
                 dst->data[index * 3 + 2] = (uint8_t)MA_CLIP(b, 0, 255);
+            } else if (dst->format == MA_PIXEL_FORMAT_RGB888_PLANAR) {
+                // NCHW: three separate R/G/B planes instead of interleaved bytes.
+                // Required for models whose input tensor is (1,3,H,W) — every
