diff --git a/sscma/core/utils/ma_nms.h b/sscma/core/utils/ma_nms.h
index 4af2a95..53c7b4a 100644
--- a/sscma/core/utils/ma_nms.h
+++ b/sscma/core/utils/ma_nms.h
@@ -16,10 +16,27 @@ namespace ma::utils {
 
 template <typename T, std::enable_if_t<std::is_base_of<ma_bbox_t, T>::value, bool> = true>
 inline float compute_iou(const T& box1, const T& box2) {
-    const float x1    = std::max(box1.x, box2.x);
-    const float y1    = std::max(box1.y, box2.y);
-    const float x2    = std::min(box1.x + box1.w, box2.x + box2.w);
-    const float y2    = std::min(box1.y + box1.h, box2.y + box2.h);
+    // ma_bbox_t::x/y is the box CENTER, not the top-left corner — every producer in
+    // sscma_micro (ma_model_yolov5/yolov8/yolo11/yolo26/fomo/nvidia_det, and both
+    // _hailo variants) writes `x_min + w/2`. The two lines below used to be
+    // `box1.x` / `box1.x + box1.w` directly, i.e. treating the center as a corner
+    // and extending the box a further half-width right / half-height down of where
+    // it actually is. Two overlapping detections of the same object almost never
+    // have identical w/h, so that extra shift doesn't cancel between the two boxes
+    // — it systematically UNDERESTIMATES the true IoU (verified by hand: two boxes
+    // with true IoU ~0.76 computed as ~0.59 under the old math). Below the 0.45
+    // default NMS threshold, that let genuine duplicate detections of one object
+    // survive as separate boxes — most visible on YOLO11's dense one-to-many head,
+    // where several adjacent grid cells/scales confidently detect the same object
+    // and are supposed to collapse into one.
+    const float b1_x1 = box1.x - box1.w * 0.5f, b1_y1 = box1.y - box1.h * 0.5f;
+    const float b1_x2 = box1.x + box1.w * 0.5f, b1_y2 = box1.y + box1.h * 0.5f;
+    const float b2_x1 = box2.x - box2.w * 0.5f, b2_y1 = box2.y - box2.h * 0.5f;
+    const float b2_x2 = box2.x + box2.w * 0.5f, b2_y2 = box2.y + box2.h * 0.5f;
+    const float x1    = std::max(b1_x1, b2_x1);
+    const float y1    = std::max(b1_y1, b2_y1);
+    const float x2    = std::min(b1_x2, b2_x2);
+    const float y2    = std::min(b1_y2, b2_y2);
     const float w     = std::max(0.0f, x2 - x1);
     const float h     = std::max(0.0f, y2 - y1);
     const float inter = w * h;
